# Local demo defaults. Change these before exposing the services beyond localhost.
OTPROOF_DB_PASSWORD=replace-this-local-demo-password
OTPROOF_DEMO_MODE=true
OTPROOF_ROLE_TOKENS=

# For non-demo mode, set OTPROOF_DEMO_MODE=false and provide a JSON token-to-role map, e.g.:
# OTPROOF_ROLE_TOKENS={"replace-engineer-token":"engineer","replace-reviewer-token":"reviewer","replace-approver-token":"approver"}
